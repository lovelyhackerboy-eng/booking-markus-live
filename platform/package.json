{
  "name": "markus-creator-os-platform",
  "private": true,
  "version": "1.3.0",
  "scripts": {
    "dev": "node scripts/copy-ui.mjs && next dev -p 3100",
    "build": "node scripts/copy-ui.mjs && next build && node scripts/build-scripts.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "scripts:build": "node scripts/build-scripts.mjs",
    "db:migrate": "node scripts/build-scripts.mjs && node dist/migrate.cjs",
    "db:seed": "node scripts/build-scripts.mjs && node dist/seed.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "mysql2": "3.24.6",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
